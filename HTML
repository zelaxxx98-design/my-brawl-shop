<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Holdik Shop - Клон (Brawl Stars)</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        /* ОСНОВНЫЕ СТИЛИ (ТЕМНАЯ ТЕМА) */
        :root {
            --bg-color: #0c101b; /* Очень темный синий */
            --card-bg: #161b29;  /* Чуть светлее для карточек */
            --accent-yellow: #f8c301; /* Желтый Холдика */
            --text-main: #ffffff;
            --text-muted: #8b9bb4;
            --gem-green: #2ecc71;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ШАПКА (HEADER) */
        header {
            background-color: var(--card-bg);
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #222a3f;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-weight: 900;
            font-size: 24px;
            color: var(--accent-yellow);
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .logo span { color: white; }

        .nav-links { display: flex; gap: 20px; }
        .nav-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            transition: 0.3s;
        }
        .nav-links a:hover, .nav-links a.active { color: white; }

        .login-btn {
            background: transparent;
            border: 2px solid var(--accent-yellow);
            color: var(--accent-yellow);
            padding: 8px 20px;
            border-radius: 5px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.3s;
        }
        .login-btn:hover {
            background: var(--accent-yellow);
            color: black;
        }

        /*ГЛАВНЫЙ КОНТЕНТ */
        main {
            flex: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 40px 20px;
            width: 100%;
            box-sizing: border-box;
        }

        .hero-title {
            text-align: center;
            font-size: 36px;
            font-weight: 900;
            margin-bottom: 10px;
            text-transform: uppercase;
        }
        .hero-title span { color: var(--accent-yellow); }

        .hero-subtitle {
            text-align: center;
            color: var(--text-muted);
            margin-bottom: 40px;
            font-size: 16px;
        }

        /* СЕТКА ТОВАРОВ (GRID) */
        .goods-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }

        /* КАРТОЧКА ТОВАРА */
        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            border: 2px solid transparent;
            transition: 0.3s;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .card:hover {
            border-color: var(--accent-yellow);
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

        /* Блик на карточке при наведении (эффект Холдика) */
        .card::after {
            content: '';
            position: absolute;
            top: -50%; line-height: -50%;
            width: 200%; height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
            transform: rotate(45deg);
            transition: 0.5s;
            opacity: 0;
        }
        .card:hover::after { opacity: 1; left: 100%; top: 100%; transition: 0.5s; }


        .card-img {
            max-width: 120px;
            margin: 0 auto 15px;
            display: block;
        }

        .card-title {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 10px;
            color: white;
        }

        .card-price-row {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .price-current {
            color: var(--gem-green);
            font-size: 22px;
            font-weight: 900;
        }

        .price-old {
            color: var(--text-muted);
            text-decoration: line-through;
            font-size: 16px;
        }

        .buy-btn {
            background-color: var(--accent-yellow);
            color: black;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 16px;
            text-transform: uppercase;
            cursor: pointer;
            width: 100%;
            transition: 0.3s;
        }

        .buy-btn:hover { background-color: white; }

        /* ПОДВАЛ (FOOTER) */
        footer {
            background-color: var(--card-bg);
            padding: 30px 20px;
            text-align: center;
            border-top: 2px solid #222a3f;
            color: var(--text-muted);
            font-size: 14px;
        }

        /* АДАПТИВНОСТЬ ДЛЯ ТЕЛЕФОНОВ */
        @media (max-width: 768px) {
            .nav-links { display: none; } /* Прячем меню */
            .hero-title { font-size: 28px; }
            .goods-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px;}
            .card { padding: 15px; }
            .card-title { font-size: 16px; }
            .price-current { font-size: 18px; }
        }
    </style>
</head>
<body>

    <header>
        <a href="#" class="logo">HOLDiK <span>SHOP</span></a>
        <div class="nav-links">
            <a href="#" class="active">Brawl Stars</a>
            <a href="#">Clash Royale</a>
            <a href="#">Отзывы</a>
            <a href="#">Гарантии</a>
        </div>
        <button class="login-btn">Войти</button>
    </header>

    <main>
        <h1 class="hero-title">Пополнение <span>Brawl Stars</span></h1>
        <p class="hero-subtitle">Гемы и Brawl Pass по тегу игрока. Безопасно.</p>

        <div class="goods-grid">
            <div class="card">
                <div>
                    <img src="https://i.imgur.com/8N4U0V8.png" alt="30 Gems" class="card-img">
                    <h3 class="card-title">30 Кристаллов</h3>
                </div>
                <div>
                    <div class="card-price-row">
                        <span class="price-current">199 ₽</span>
                        <span class="price-old">249 ₽</span>
                    </div>
                    <button class="buy-btn" onclick="redirectToPay('30 Гемов')">Купить</button>
                </div>
            </div>

            <div class="card">
                <div>
                    <img src="https://i.imgur.com/M6Lw1O4.png" alt="80 Gems" class="card-img">
                    <h3 class="card-title">80 Кристаллов</h3>
                </div>
                <div>
                    <div class="card-price-row">
                        <span class="price-current">499 ₽</span>
                    </div>
                    <button class="buy-btn" onclick="redirectToPay('80 Гемов')">Купить</button>
                </div>
            </div>

            <div class="card">
                <div>
                    <img src="https://i.imgur.com/uN2j9bT.png" alt="Brawl Pass" class="card-img">
                    <h3 class="card-title">Brawl Pass Plus</h3>
                </div>
                <div>
                    <div class="card-price-row">
                        <span class="price-current">999 ₽</span>
                        <span class="price-old">1299 ₽</span>
                    </div>
                    <button class="buy-btn" onclick="redirectToPay('Brawl Pass Plus')">Купить</button>
                </div>
            </div>

             <div class="card">
                <div>
                    <img src="https://i.imgur.com/M6Lw1O4.png" alt="170 Gems" class="card-img">
                    <h3 class="card-title">170 Кристаллов</h3>
                </div>
                <div>
                    <div class="card-price-row">
                        <span class="price-current">949 ₽</span>
                    </div>
                    <button class="buy-btn" onclick="redirectToPay('170 Гемов')">Купить</button>
                </div>
            </div>

        </div>
    </main>

    <footer>
        <p>&copy; 2023 Holdik Shop Clone. Not affiliated with Supercell.</p>
        <p style="font-size: 12px; margin-top: 10px;">Сайт создан в учебных целях.</p>
    </footer>

    <script>
        // Функция при нажатии кнопки Купить
        function redirectToPay(itemName) {
            // На статичном сайте нельзя сделать корзину.
            // Поэтому мы просто перенаправляем человека туда, где вы принимаете оплату.
            
            alert('Вы выбрали: ' + itemName + '.\nНа GitHub Pages нет встроенной оплаты.\nСейчас откроется Telegram для оформления заказа вручную.');
            
            // ЗАМЕНИТЕ ЭТУ ССЫЛКУ на свой Telegram или платежную ссылку (DonationAlerts и т.д.)
            window.location.href = "https://t.me/your_telegram_username"; 
        }
    </script>

</body>
</html>
